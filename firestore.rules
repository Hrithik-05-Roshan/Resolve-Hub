rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId) && isValidId(userId);

      // Connected Platforms
      match /platforms/{platformId} {
        allow read, write: if isOwner(userId) && isValidId(platformId);
      }

      // Connected Accounts
      match /connected_accounts/{accountId} {
        allow read, write: if isOwner(userId) && isValidId(accountId);
      }

      // Orders Subcollection
      match /orders/{orderId} {
        allow read, write: if isOwner(userId) && isValidId(orderId);
      }

      // Issues Subcollection
      match /issues/{issueId} {
        allow read, write: if isOwner(userId) && isValidId(issueId);
      }

      // Audit Logs Subcollection
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId) && isValidId(logId);
      }

      // Notifications Subcollection
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) && isValidId(notifId);
      }
    }
  }
}
